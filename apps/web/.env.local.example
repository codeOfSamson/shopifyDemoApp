# 1. In the Shopify dev store admin: Settings → Apps and sales channels →
#    Develop apps → Create an app.
# 2. Configuration → Storefront API integration → enable the scopes you
#    need (product/collection/cart reads at minimum).
# 3. Install the app, copy the Storefront API access token.
# 4. Copy this file to .env.local and fill in the values below.

SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shared secret configured on the Shopify `products/update` webhook
# (see app/api/webhooks/products-update/route.ts) — verifies the
# X-Shopify-Hmac-Sha256 signature before revalidating a product's cache tag.
SHOPIFY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shared secret for the CMS's publish webhook (see
# app/api/webhooks/cms-publish/route.ts) — optional in local dev, only
# needed if you're wiring up a real headless CMS for /lp/[slug] pages.
CMS_WEBHOOK_SECRET=

# Origin of the inventory-ops zone that /inventory rewrites to (see
# next.config.ts). Defaults to http://localhost:3001 for local dev — a
# real deploy MUST set this to inventory-ops's production URL, otherwise
# the /inventory rewrite silently points at localhost.
INVENTORY_OPS_ORIGIN=http://localhost:3001
